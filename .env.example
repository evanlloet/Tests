# --- Base de données (obligatoire) -------------------------------------------
# PostgreSQL 15+ : instance locale, Supabase (chaîne de connexion « Session pooler »
# ou directe), Neon, etc. Toutes les données métier sont persistées ici.
DATABASE_URL=postgres://lea:lea@localhost:5432/lea_dev

# --- Authentification ----------------------------------------------------------
# Autoriser la création de compte depuis l'écran d'inscription (true/false).
# Une fois le compte de la commerciale créé, passez à false.
ALLOW_SIGNUP=true

# --- Routage (facultatif) ------------------------------------------------------
# Moteur d'itinéraires routiers : « ign » (par défaut, Géoplateforme IGN, sans clé),
# « osrm » (serveur OSRM_URL) ou « estimate » (aucun appel : estimation à vol
# d'oiseau, clairement signalée). Si le moteur ne répond pas, Léa repasse
# automatiquement à l'estimation et l'indique.
ROUTING_PROVIDER=
IGN_ROUTING_URL=https://data.geopf.fr/navigation
# URL d'un serveur OSRM (ex. https://osrm.mon-domaine.fr), utilisé si renseigné.
OSRM_URL=
# Valhalla (alternative à OSRM) — non implémenté en V1, prévu dans l'interface.

# --- Géocodage (facultatif) ----------------------------------------------------
# Service de géocodage de la Géoplateforme IGN (API publique, sans clé).
# Laisser vide pour désactiver le géocodage automatique.
GEOCODER_URL=https://data.geopf.fr/geocodage

# --- Carte ---------------------------------------------------------------------
# Style MapLibre ou modèle de tuiles raster. Par défaut : Plan IGN (Géoplateforme).
NEXT_PUBLIC_MAP_RASTER_TILES=https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&TILEMATRIXSET=PM&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&FORMAT=image/png
NEXT_PUBLIC_MAP_ATTRIBUTION=© IGN – Géoplateforme
